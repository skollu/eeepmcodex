NEXT_PUBLIC_SITE_URL=https://eeepm.com
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Optional server-only token if public editorial content is in a private dataset.
SANITY_API_READ_TOKEN=
# Keep disabled for staging. Enable only after approved production-domain launch.
SITE_INDEXING=disabled
# Keep false until private storage, staff access, and deployed tests are verified.
LEAD_SUBMISSIONS_ENABLED=false
# Dedicated private dataset/project only. Never use NEXT_PUBLIC_ for these.
SANITY_LEADS_PROJECT_ID=
SANITY_LEADS_DATASET=
SANITY_LEADS_WRITE_TOKEN=
LEAD_NOTIFICATION_EMAIL=team@eeepm.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
